# Nenhuma chave é obrigatória para começar — o motor de transcrição padrão
# (--engine local, WhisperX) não usa nenhuma delas.

# Só necessária se você usar --engine elevenlabs (transcrição em nuvem com
# diarização de fábrica) ou helpers/voiceover.py (narração por TTS).
# Pegue em https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Só necessária se você usar --diarize no motor local (identificação de
# falantes rodando na sua própria máquina, via pyannote).
# Pegue um token gratuito em https://huggingface.co/settings/tokens e
# aceite os termos do modelo pyannote/speaker-diarization-3.1 uma vez.
HF_TOKEN=
